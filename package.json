{
  "name": "btvn-ai-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Không gian học tập AI có kiểm duyệt dành cho giáo viên và học sinh",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore.mjs"
  }
}
